+                dst[4*x+2] = src[4*x]; dst[4*x+3] = 255;
+            }
         }
         if (!pending) { dirtyFirst = dirtyLast = y; pending = true; }
         else { dirtyFirst = std::min(dirtyFirst, y); dirtyLast = std::max(dirtyLast, y); }
     }
+    if (forceFullFrame) {
+        pending = true; dirtyFirst = 0; dirtyLast = height - 1;
+    }
     havePost = true;
 }
